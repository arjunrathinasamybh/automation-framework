# Normalise line endings in the repository to LF, and check out native on each platform.
# Without this, a Windows dev and a Linux CI agent produce spurious whole-file diffs.
* text=auto

*.cs        text diff=csharp
*.csproj    text
*.slnx      text
*.json      text
*.feature   text
*.md        text
*.yml       text

# Binary — never touch these.
*.png       binary
*.jpg       binary
*.ico       binary
*.dll       binary
