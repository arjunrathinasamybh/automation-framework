{
  // How the signed-in session is shared between scenarios.
  "Session": {
    // Fresh - every scenario gets a clean, unauthenticated browser and signs in for itself. Complete
    //         isolation, and the obvious behaviour — but every scenario pays a full Entra sign-in, plus
    //         an MFA approval each when no TOTP secret is configured. Ten scenarios, ten approvals.
    //
    // Reuse - sign in once per run into a persistent browser profile; every later scenario launches
    //         already authenticated. One sign-in and one MFA approval per run, whatever the scenario
    //         count. Two things follow from it automatically, because they are requirements rather than
    //         choices — see SessionProfile for why:
    //           * the browser runs Normal, not InPrivate (InPrivate discards the profile by design);
    //           * "Stay signed in?" is answered Yes (the cookie must outlive the browser process).
    //
    //         The trade is isolation: scenarios inherit whatever the shared profile holds — cookies, and
    //         any server-side state their account accumulated. A scenario that must start from a clean,
    //         unauthenticated browser tags itself @fresh-session and always gets one.
    //
    // KNOWN BROKEN — do not set to Reuse yet. Verified against a live tenant on 2026-07-17: the sign-in
    // persists correctly (the profile does receive ESTSAUTHPERSISTENT), but the *second* scenario's
    // browser dies with "invalid session id ... not connected to DevTools" — a second Chromium process
    // reaching a --user-data-dir the previous one has not finished releasing. That death half-writes the
    // profile, and every scenario after it launches holding cookies, so Microsoft 365 attempts a silent
    // SSO instead of an interactive sign-in and Entra refuses it:
    //     error_description: "Session information is not sufficient for single-sign-on."
    // which the app renders as "Sorry, we're having trouble verifying your account."
    // Sharing one profile between consecutive browser *processes* is the flawed premise; see the Known
    // limits section of docs/architecture.md.
    "Mode": "Fresh",

    // Where the reused profile lives, relative to the test output directory. It holds a live session for
    // the test account, so treat the directory as a credential — the default keeps it out of the repo.
    "ProfileDirectory": "SessionProfile",

    // Discard the profile as each run starts, so a run always begins from one deliberate sign-in.
    // Set false to carry it between runs: the local edit-run loop then costs no MFA at all, at the price
    // of a stale profile outliving the change that invalidated it (a password reset, a revoked session),
    // which surfaces as a puzzling failure rather than a clean sign-in prompt.
    "ResetOnRunStart": true
  }
}
