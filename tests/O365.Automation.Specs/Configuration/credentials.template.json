{
  // TEMPLATE — this file is committed and must never contain real values.
  //
  // Copy it to `credentials.json` (which is git-ignored) and fill it in:
  //     copy Configuration\credentials.template.json Configuration\credentials.json
  //
  // Safer still, leave the secrets out of the file altogether and supply them out-of-band. Both of these
  // override credentials.json, so the Username can live in the file while the secrets do not:
  //
  //   Locally:  dotnet user-secrets set "Credentials:Password"   "<password>"
  //             dotnet user-secrets set "Credentials:TotpSecret" "<base32-secret>"
  //
  //   In CI:    Credentials__Password    (from the pipeline secret store)
  //             Credentials__TotpSecret
  "Credentials": {
    // UPN of the automation account, e.g. svc.automation@contoso.onmicrosoft.com
    "Username": "",

    "Password": "",

    // Base32 secret captured when the authenticator app was enrolled — the text shown under the QR code,
    // not the QR image and not a recovery code.
    //
    // OPTIONAL. Leave it empty and MFA becomes interactive: the run pauses, hands you the browser, and you
    // complete the challenge yourself (Authenticator, push approval, SMS, hardware key), after which it
    // resumes. See Configuration/mfa.json. A secret is only required for unattended or headless runs.
    "TotpSecret": "",

    // Answer to the "Stay signed in?" prompt. Pointless for InPrivate runs, which discard the cookie.
    "StaySignedIn": false
  }
}
